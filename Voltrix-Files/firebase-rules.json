{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "active": {
          ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' && root.child('admins').child(auth.uid).child('active').val() === true && root.child('admins').child($uid).child('role').val() !== 'owner' && auth.uid !== $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "status": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('admins').child(auth.uid).child('active').val() === true",
        ".validate": "newData.hasChildren(['state','t']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline')"
      }
    },
    "vault": {
      ".read": "auth != null && root.child('admins').child(auth.uid).child('active').val() === true",
      "url": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner' && root.child('admins').child(auth.uid).child('active').val() === true",
        ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[^ ]{1,500}$/)"
      }
    }
  }
}
